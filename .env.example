# ============================================================================
# ZYVRA — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real passwords, GitHub Personal Access Tokens, or API keys to Git!
# NEVER place administrator passwords, private admin emails, or secrets in VITE_ variables!

# Optional: Base URL path when deploying to a subdirectory (e.g., "/Zyvra-V1.0/" for GitHub Pages)
# Leave empty or "./" for automatic relative asset resolution.
VITE_BASE_PATH="./"

# Optional: Production Backend API Base URL for server-side Admin Auth, Cloud DB & Payments
# Leave empty when running on unified full-stack server or static-only GitHub Pages.
VITE_API_BASE_URL=""

# ============================================================================
# SERVER-SIDE ONLY VARIABLES (Used by `server.ts` — NEVER exposed to frontend)
# ============================================================================
# Initial Admin Seed Credentials (optional; can also be configured via Setup UI)
ADMIN_LOGIN_ID=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
ALLOWED_ORIGIN="http://localhost:3000"

# Private Admin Recovery & Security Verification Email (Server-Side Only)
# Used exclusively by the backend to send 5-minute cryptographic OTP codes
# when the authenticated Admin changes their User ID or Password.
ADMIN_SECURITY_EMAIL=""

# Server-Side Email Delivery Configuration for Admin OTP (Resend HTTP API or Resend/Standard SMTP):
# Primary: Resend API
RESEND_API_KEY=""
SMTP_FROM="Zyvra <onboarding@resend.dev>"

# Optional SMTP Fallback (e.g., smtp.resend.com:465 or smtp.gmail.com:465)
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASS=""

# Optional: Gemini API Key (server-side only for live AI question translation)
GEMINI_API_KEY=""
APP_URL=""
