# ============================================================================
# ZYVRA — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real passwords, GitHub Personal Access Tokens, or API keys to Git!
# NEVER place administrator passwords or secrets in VITE_ variables!

# Optional: Base URL path when deploying to a subdirectory (e.g., "/Zyvra-V1.0/" for GitHub Pages)
# Leave empty or "./" for automatic relative asset resolution.
VITE_BASE_PATH="./"

# Optional: Production Backend API Base URL for server-side Admin Auth, Cloud DB & Payments
# Leave empty when running on static-only GitHub Pages.
VITE_API_BASE_URL=""

# ============================================================================
# SERVER-SIDE ONLY VARIABLES (Used by `server.mjs` — NEVER exposed to frontend)
# ============================================================================
# Generate a salted scrypt hash using: node server.mjs --hash "YourStrongPassword"
ADMIN_LOGIN_ID=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
ALLOWED_ORIGIN="http://localhost:3000"

# Optional: Gemini API Key (server-side only if running a Node backend)
GEMINI_API_KEY=""
APP_URL=""
