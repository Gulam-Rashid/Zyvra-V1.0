# ============================================================================
# ZYVRA — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit real passwords, GitHub Personal Access Tokens, or API keys to Git!

# Optional: Base URL path when deploying to a subdirectory (e.g., "/zyvra/" for GitHub Pages)
# Leave empty or "./" for automatic relative asset resolution.
VITE_BASE_PATH="./"

# Optional: Administrator Login Identifier (Default: Sajiya@8800)
# Note: Do NOT put the administrator password here in frontend env vars.
VITE_ADMIN_LOGIN_ID="Sajiya@8800"

# Optional: Production Backend API Base URL for server-side Admin Auth, Cloud DB & Payments
# When omitted, Zyvra runs in Static / Offline-First Local Mode (suitable for GitHub Pages).
VITE_API_BASE_URL=""

# Optional: Gemini API Key (server-side only if running a Node/Express backend)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
